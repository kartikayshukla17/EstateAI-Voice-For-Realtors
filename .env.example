# See docs/SETUP.md for how to get each of these.

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Neon Postgres
DATABASE_URL=

# Gemini (post-call scoring)
GEMINI_API_KEY=

# Gmail SMTP (magic-link transport — no domain needed; swap for Resend later
# once you own a domain)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
